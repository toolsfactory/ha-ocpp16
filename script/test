#!/bin/bash

# script/test: Run project tests
#
# Runs integration tests plus synchronized tooling tests with the project
# configuration. Automatically cleans up package installations after the run.
#
# Usage:
#   ./script/test [OPTIONS] [PYTEST_OPTIONS]
#
# Options:
#   --cov           Generate coverage report (terminal output)
#   --cov-html      Generate HTML coverage report in htmlcov/
#
# Examples:
#   ./script/test
#   ./script/test -v
#   ./script/test --cov
#   ./script/test --cov-html
#   ./script/test --cov -k test_midnight
#   ./script/test tests/test_cache_validity.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"
# shellcheck source=script/.lib/integration.sh
source "$SCRIPT_DIR/.lib/integration.sh"

activate_venv

# Clean up any accidental package installation from pytest/test dependencies on every exit path
# (success, a failing test under `set -e`, or any other early exit) -- this prevents Home Assistant
# from loading an installed version instead of the development version from custom_components/.
trap '"$SCRIPT_DIR/clean" --minimal' EXIT

# Parse coverage flags
COVERAGE_ARGS=()
PYTEST_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
    --cov)
        COVERAGE_ARGS+=("--cov=$INTEGRATION_PATH" "--cov-report=term-missing")
        shift
        ;;
    --cov-html)
        COVERAGE_ARGS+=("--cov=$INTEGRATION_PATH" "--cov-report=html")
        shift
        ;;
    *)
        PYTEST_ARGS+=("$1")
        shift
        ;;
    esac
done

# pytest is expected to already be on PATH via script/setup/bootstrap (HA's own
# requirements_test.txt) -- there is no "test" extra in pyproject.toml to fall back to, and a
# broken editable-install fallback here previously left `occp` itself importable, which can
# shadow `custom_components.occp` in Home Assistant's loader.
if ! python -c "import pytest" 2>/dev/null; then
    log_error "pytest not found. Run: script/setup/bootstrap"
    exit 1
fi

# Run pytest with project configuration
if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]]; then
    log_header "Running tests with coverage"
else
    log_header "Running tests"
fi
echo ""

run_hook "test" "pre"
echo ""
TEST_PATHS="tests"
if [[ -d script/tests ]]; then
    TEST_PATHS+=" script/tests"
fi
pytest --override-ini "testpaths=$TEST_PATHS" "${COVERAGE_ARGS[@]}" "${PYTEST_ARGS[@]}"

run_hook "test" "post"

log_success "Tests completed"

if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]] && [[ " ${COVERAGE_ARGS[*]} " =~ " --cov-report=html " ]]; then
    echo ""
    log_success "Coverage report generated in htmlcov/index.html"
fi
